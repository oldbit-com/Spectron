<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:OldBit.Spectron.ViewModels"
        xmlns:controls="clr-namespace:OldBit.Spectron.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="OldBit.Spectron.Views.PaletteView"
        x:DataType="viewModels:PaletteEditorViewModel"
        WindowStartupLocation="CenterScreen"
        Width="720"
        Height="530"
        Title="Palette Editor">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.Header">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="controls|PaletteCell">
            <Setter Property="IsReadOnly" Value="{Binding !((viewModels:PaletteEditorViewModel)DataContext).IsEditable, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="110,*" Margin="10">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="SELECTED PALETTE" Margin="8 0 0 2" FontSize="10" />
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    ItemsSource="{Binding Palettes}"
                    SelectedItem="{Binding SelectedPalette}"
                    DisplayMemberBinding="{Binding Name}"
                    Padding="8"
                    Width="250" />

                <Button Content="Clone" Margin="10 0 0 0" Command="{Binding ClonePaletteCommand}"/>
                <Button Content="Delete" Margin="10 0 0 0" Command="{Binding DeletePaletteCommand}"/>
                <Button Content="Use" Margin="10 0 0 0" Command="{Binding UsePaletteCommand}"/>
            </StackPanel>

            <TextBlock Text="PALETTE NAME" Margin="8 10 0 2" FontSize="10" />
            <TextBox
                Text="{Binding PaletteName}"
                IsReadOnly="{Binding !IsEditable}"
                MaxLength="50"
                Width="370"
                HorizontalAlignment="Left"
                VerticalContentAlignment="Center" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            DataContext="{Binding SelectedPalette}"
            IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}"
            RowDefinitions="20,35,35,35,35,35,35,35,35"
            ColumnDefinitions="20,100,100,100,100,100,100"
            RowSpacing="10"
            ColumnSpacing="10">

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Ink" Classes="Header"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="Ink Bright" Classes="Header"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Paper" Classes="Header"/>
            <TextBlock Grid.Row="0" Grid.Column="5" Text="Paper Bright" Classes="Header"/>
            <TextBlock Grid.Row="0" Grid.Column="6" Text="Border" Classes="Header"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="0" Opacity="0.7"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="1" Opacity="0.7"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="2" Opacity="0.7"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="3" Opacity="0.7"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="4" Opacity="0.7"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="5" Opacity="0.7"/>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="6" Opacity="0.7"/>
            <TextBlock Grid.Row="8" Grid.Column="0" Text="7" Opacity="0.7"/>

            <TextBlock Grid.Row="1" Grid.Column="1" Text="Black"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Blue"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Red"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Magenta"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="Green"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="Cyan"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Text="Yellow"/>
            <TextBlock Grid.Row="8" Grid.Column="1" Text="White"/>

            <controls:PaletteCell Grid.Row="1" Grid.Column="2" Background="{Binding Colors[0], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="2" Grid.Column="2" Background="{Binding Colors[1], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="3" Grid.Column="2" Background="{Binding Colors[2], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="4" Grid.Column="2" Background="{Binding Colors[3], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="5" Grid.Column="2" Background="{Binding Colors[4], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="6" Grid.Column="2" Background="{Binding Colors[5], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="7" Grid.Column="2" Background="{Binding Colors[6], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="8" Grid.Column="2" Background="{Binding Colors[7], Mode=TwoWay}"/>

            <controls:PaletteCell Grid.Row="1" Grid.Column="3" Background="{Binding Colors[8], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="2" Grid.Column="3" Background="{Binding Colors[9], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="3" Grid.Column="3" Background="{Binding Colors[10], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="4" Grid.Column="3" Background="{Binding Colors[11], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="5" Grid.Column="3" Background="{Binding Colors[12], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="6" Grid.Column="3" Background="{Binding Colors[13], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="7" Grid.Column="3" Background="{Binding Colors[14], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="8" Grid.Column="3" Background="{Binding Colors[15], Mode=TwoWay}"/>

            <controls:PaletteCell Grid.Row="1" Grid.Column="4" Background="{Binding Colors[16], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="2" Grid.Column="4" Background="{Binding Colors[17], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="3" Grid.Column="4" Background="{Binding Colors[18], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="4" Grid.Column="4" Background="{Binding Colors[19], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="5" Grid.Column="4" Background="{Binding Colors[20], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="6" Grid.Column="4" Background="{Binding Colors[21], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="7" Grid.Column="4" Background="{Binding Colors[22], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="8" Grid.Column="4" Background="{Binding Colors[23], Mode=TwoWay}"/>

            <controls:PaletteCell Grid.Row="1" Grid.Column="5" Background="{Binding Colors[24], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="2" Grid.Column="5" Background="{Binding Colors[25], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="3" Grid.Column="5" Background="{Binding Colors[26], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="4" Grid.Column="5" Background="{Binding Colors[27], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="5" Grid.Column="5" Background="{Binding Colors[28], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="6" Grid.Column="5" Background="{Binding Colors[29], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="7" Grid.Column="5" Background="{Binding Colors[30], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="8" Grid.Column="5" Background="{Binding Colors[31], Mode=TwoWay}"/>

            <controls:PaletteCell Grid.Row="1" Grid.Column="6" Background="{Binding Colors[32], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="2" Grid.Column="6" Background="{Binding Colors[33], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="3" Grid.Column="6" Background="{Binding Colors[34], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="4" Grid.Column="6" Background="{Binding Colors[35], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="5" Grid.Column="6" Background="{Binding Colors[36], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="6" Grid.Column="6" Background="{Binding Colors[37], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="7" Grid.Column="6" Background="{Binding Colors[38], Mode=TwoWay}"/>
            <controls:PaletteCell Grid.Row="8" Grid.Column="6" Background="{Binding Colors[39], Mode=TwoWay}"/>

        </Grid>
    </Grid>
</Window>

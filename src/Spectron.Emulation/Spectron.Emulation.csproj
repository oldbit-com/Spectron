<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>OldBit.Spectron.Emulation</AssemblyName>
        <RootNamespace>OldBit.Spectron.Emulation</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <EmbeddedResource Include="Rom\Files\*.*" />
      <EmbeddedResource Include="Tape\Loader\Files\*.*" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>OldBit.Spectron.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>OldBit.Spectron.Emulator.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>OldBit.Spectron.Debugger.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>OldBit.Spectron.Integration.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>OldBit.Spectron.Debugger</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>OldBit.Spectron.Mcp</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>OldBit.Spectron.Mcp.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="MemoryPack" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
      <PackageReference Include="OldBit.Beep" />
      <PackageReference Include="OldBit.Joypad" />
      <PackageReference Include="OldBit.Z80Cpu.Spectron" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Devices\Beta128\Controller\DiskController.Read.cs">
        <DependentUpon>DiskController.cs</DependentUpon>
      </Compile>
      <Compile Update="Devices\Beta128\Controller\DiskController.Command.cs">
        <DependentUpon>DiskController.cs</DependentUpon>
      </Compile>
      <Compile Update="Devices\Beta128\Controller\DiskController.StepSeek.cs">
        <DependentUpon>DiskController.cs</DependentUpon>
      </Compile>
      <Compile Update="Devices\Beta128\Controller\DiskController.Write.cs">
        <DependentUpon>DiskController.cs</DependentUpon>
      </Compile>
      <Compile Update="Devices\Beta128\Controller\DiskController.Control.cs">
        <DependentUpon>DiskController.cs</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Spectron.Files\Spectron.Files.csproj" />
    </ItemGroup>

</Project>
